# ┌──────────────────────────────────────────────────────────────┐
# │  采购工作站 — 环境变量模板                                        │
# │  复制为 .env 后填写，切勿将 .env 提交到 Git！                       │
# └──────────────────────────────────────────────────────────────┘

# ── 数据库 ─────────────────────────────────────────────────────
# SQLite 文件路径（相对于 server/ 目录）
DATABASE_URL="file:./prisma/dev.db"

# ── JWT 签名密钥 ────────────────────────────────────────────────
# 必填，至少 32 字符，生产环境请使用随机字符串
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# ── LLM API Key 加密密钥 ────────────────────────────────────────
# 必填（部署脚本会自动生成）。用于加密存储用户的 AI 服务密钥。
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── CORS 允许来源 ───────────────────────────────────────────────
# 生产环境必填，填写访问地址（IP 或域名），多个用逗号分隔
# 示例（IP）:    ALLOWED_ORIGINS="http://1.2.3.4"
# 示例（域名）:  ALLOWED_ORIGINS="https://kanban.yourcompany.com"
ALLOWED_ORIGINS=""

# ── 服务端口 ────────────────────────────────────────────────────
PORT=3001

# ── 前端访问地址（密码重置邮件链接） ─────────────────────────────
# 必须与实际访问地址一致，否则邮件中的重置链接无法点击
# 示例（IP）:    FRONTEND_URL="http://1.2.3.4"
# 示例（域名）:  FRONTEND_URL="https://kanban.yourcompany.com"
FRONTEND_URL="http://localhost:5173"

# ── SMTP 邮件（可选） ───────────────────────────────────────────
# 未配置时，提醒和密码重置邮件降级为 console 日志
#
# QQ 邮箱示例:  SMTP_HOST=smtp.qq.com  SMTP_PORT=465  （需在 QQ 邮箱开启 SMTP 并获取授权码）
# 163 邮箱示例: SMTP_HOST=smtp.163.com SMTP_PORT=465
# 企业邮箱:     SMTP_HOST=smtp.exmail.qq.com SMTP_PORT=465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
