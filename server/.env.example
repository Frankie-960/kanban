# 数据库连接 (SQLite 文件路径)
DATABASE_URL="file:./prisma/dev.db"

# JWT 密钥 — 必须设置，至少 32 字符，生产环境务必使用随机字符串
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# API Key 加密密钥 (可选，推荐在生产环境配置)
# 配置后，用户的 LLM API Key 将加密存储在数据库中
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# 允许的前端来源，逗号分隔 (生产环境必须配置，否则 CORS 对所有域名开放)
# 示例: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=""

# 后端服务端口
PORT=3001

# 前端URL (用于密码重置邮件中的链接)
FRONTEND_URL="http://localhost:5173"

# SMTP 邮件配置 (可选，未配置时提醒和密码重置邮件将降级为 console 日志)
# 示例: QQ邮箱: SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_USER=your@qq.com, SMTP_PASS=授权码
# 示例: 163邮箱: SMTP_HOST=smtp.163.com, SMTP_PORT=465
# 示例: Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
